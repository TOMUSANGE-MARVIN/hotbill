# HotBill RADIUS SQL module — reads the radcheck/radreply/radacct tables the
# Laravel app already writes. DB creds are substituted from env by entrypoint.sh.
sql {
    dialect = "mysql"
    driver = "rlm_sql_mysql"

    server = "@@DBHOST@@"
    port = 3306
    login = "@@DBUSER@@"
    password = "@@DBPASS@@"
    radius_db = "@@DBNAME@@"

    # Routers are authorised via the wildcard client in clients.conf, not the
    # nas table (their NAT'd IPs change), so don't load clients from SQL.
    read_clients = no
    client_table = "nas"

    # Standard schema table/column names.
    acct_table1 = "radacct"
    acct_table2 = "radacct"
    postauth_table = "radpostauth"
    authcheck_table = "radcheck"
    authreply_table = "radreply"
    groupcheck_table = "radgroupcheck"
    groupreply_table = "radgroupreply"
    usergroup_table = "radusergroup"

    # Variables referenced by the bundled queries.conf.
    sql_user_name = "%{User-Name}"
    group_attribute = "SQL-Group"
    read_groups = yes
    read_profiles = yes
    delete_stale_sessions = yes
    default_user_profile = ""

    pool {
        start = 1
        min = 1
        max = 5
        spare = 1
        uses = 0
        lifetime = 0
        idle_timeout = 60
    }

    $INCLUDE ${modconfdir}/${.:name}/main/${dialect}/queries.conf
}
