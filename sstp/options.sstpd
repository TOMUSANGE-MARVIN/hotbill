# pppd options for SSTP sessions (used by sstp-server via --pppd-config).
# Auth comes from /etc/ppp/chap-secrets (symlinked to the shared HotBill file):
#   <router-token>  *  <secret>  <pinned-ip>
# The 4th column pins each router's tunnel IP so HotBill can reach it.
name hotbill-sstp
require-mschap-v2

# TLS already encrypts the tunnel; MPPE matches RouterOS default-encryption.
# If the host kernel lacks MPPE, switch RouterOS to profile=default and set
# `nomppe` here (see the SSTP setup notes).
mppe required,stateless

# The server (local) IP is supplied by sstpd via --local; the client (remote)
# IP is taken from the chap-secrets 4th column. Don't pin IPs here too.

# Keepalives so dead sessions are reaped and routers reconnect.
lcp-echo-interval 30
lcp-echo-failure 4

# This is a management tunnel only — never touch the router's default route
# or proxy-arp on the server.
nodefaultroute
noproxyarp
novj
noccp
